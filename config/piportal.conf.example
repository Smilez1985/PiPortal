# =============================================================================
#  PiPortal – zentrale Konfiguration
# =============================================================================
#  Kopiere diese Datei nach  config/piportal.conf  und passe die Werte an:
#      cp config/piportal.conf.example config/piportal.conf
#      nano config/piportal.conf
#
#  config/piportal.conf ist per .gitignore vom Repo ausgeschlossen und darf
#  Secrets (WLAN-Passwörter) enthalten. Diese .example-Datei niemals mit
#  echten Passwörtern füllen!
#
#  Leere WLAN-Felder => der Installer fragt interaktiv nach bzw. übernimmt
#  eine bereits vorhandene wpa_supplicant.conf.
# =============================================================================

# ---------------------------------------------------------------- Hostname ---
# Gerätename (Zugriff u. a. via \\<name>.local vom Windows-PC).
PIPORTAL_HOSTNAME="PiPortal"

# ------------------------------------------------------------------ USB-LAN --
# Feste IP des Pi auf der USB-Netzwerkschnittstelle (Gegenstelle zum Windows-PC).
# Laut Projektvorgabe darf 10.10.0.x im Repo im Klartext stehen.
USB_LAN_IP="10.10.0.1"
USB_LAN_PREFIX="24"                 # CIDR-Prefix (24 = 255.255.255.0)

# DHCP-Bereich, den der Pi dem Windows-Host zuweist.
DHCP_RANGE_START="10.10.0.10"
DHCP_RANGE_END="10.10.0.50"
DHCP_LEASE="24h"

# ------------------------------------------------------------------- Gadget --
# USB-Identität des Gadgets. 1d6b/0104 = Linux Foundation / Multifunction
# Composite Gadget (Standard, kein fremder Hersteller wird imitiert).
GADGET_VENDOR_ID="0x1d6b"
# Eindeutige Product-ID. Falls Windows das Gadget nach vielen Tests „falsch"
# gecacht hat (RNDIS bindet nicht mehr), hier einen neuen Wert setzen –
# Windows sieht dann ein frisches Gerät und liest die MS-OS-Descriptoren neu.
GADGET_PRODUCT_ID="0xa4ac"
GADGET_MANUFACTURER="PiPortal"
GADGET_PRODUCT="PiPortal Composite Gadget"
# Seriennummer: leer => wird deterministisch aus /etc/machine-id abgeleitet.
GADGET_SERIAL=""

# Welche Gadget-Funktionen aktiv sind (1 = an, 0 = aus).
# WICHTIG: RNDIS + ECM zusammen ergibt ein Multi-Config-Gadget, das Windows
# NICHT sauber bindet (keine Treiber für die Funktionen). Für Windows-Hosts
# daher nur RNDIS (Single-Config). ECM nur aktivieren, wenn der Host Linux/macOS
# ist – dann RNDIS besser ausschalten.
NET_MODE="auto"                     # auto | ncm | rndis  (Windows-Netzwerk-Face in c.1)
                                    #   auto  = NCM zuerst (treiberlos auf Win11), Fallback
                                    #           auf RNDIS, wenn der Host NCM nicht annimmt
                                    #   ncm   = nur NCM (modern, WINNCM-os_desc)
                                    #   rndis = nur RNDIS (Opt-in; breiteste Alt-Reichweite)
NET_DETECT_WAIT="20"                # Sekunden auf NCM-Annahme warten, dann RNDIS-Fallback
ENABLE_ECM="0"                      # optionales Linux/macOS-Face – für Windows AUS lassen
ENABLE_MASS_STORAGE="1"             # read-only Wegweiser-Datenträger

# --------------------------------------------------------------------- WLAN --
# EMPFEHLUNG: WLAN in DietPi verwalten (dietpi-config / dietpi-wifi.txt) und die
# Felder hier LEER lassen. Dann fasst der Installer die wpa_supplicant.conf nicht
# an, nutzt ALLE dort hinterlegten Netze und übernimmt deren Reihenfolge (priority=).
# Der Roaming-Dienst leitet das bevorzugte Heimnetz automatisch aus der höchsten
# OS-priority ab – nichts muss hierher kopiert werden.
WIFI_COUNTRY="DE"

# Optionaler Override des Heim-Vorzugs für den Roaming-Dienst: NUR die SSID (kein
# Zwang zum PSK). Leer => die höchste OS-priority entscheidet. Trägst du unten
# jedoch WIFI_HOME_SSID + WIFI_HOTSPOT_SSID ein, ÜBERSCHREIBT der Installer die
# wpa_supplicant.conf mit genau diesen zwei Profilen (mit vorherigem Backup) –
# nur wählen, wenn PiPortal das WLAN allein verwalten soll.

# Profil 1: bevorzugtes Heim-WLAN (höhere Priorität).
WIFI_HOME_SSID=""
WIFI_HOME_PSK=""

# Profil 2: Handy-Hotspot als Fallback.
WIFI_HOTSPOT_SSID=""
WIFI_HOTSPOT_PSK=""

# Roaming: Signalschwelle (dBm) und Prüfintervall (Sekunden) des bgscan.
WIFI_BGSCAN="simple:30:-65:300"
WIFI_ROAM_INTERVAL="15"            # Sekunden zwischen Roaming-Prüfungen

# ---------------------------------------------------------------------- SMB --
SMB_USER=""                         # leer = automatisch (SSH-Login/SUDO_USER, sonst Repo-Eigentümer; nie root). Oder fester Name.
SMB_SHARE_NAME="PiPortal"           # Freigabename => \\10.10.0.1\PiPortal
SMB_SHARE_PATH="/srv/piportal/share"
# SMB-Passwort: leer => der Installer fragt interaktiv nach (empfohlen).
SMB_PASSWORD=""
SMB_ENCRYPT="0"                     # 1 = SMB3-Verschlüsselung erzwingen (CPU-Last)

# ------------------------------------------------------------------- Portal --
PORTAL_LABEL="PIPORTAL"             # Datenträgername (max. 11 Zeichen)
PORTAL_IMAGE="/srv/piportal/portal.img"   # read-only FAT-Wegweiser-Image

# -------------------------------------------------------------------- Extras --
ENABLE_SSH_HELPER="1"               # connect-piportal.cmd aufs Portal legen
ENABLE_CLAUDE_CODE="0"              # Node.js LTS + Claude Code CLI installieren (Opt-in)
ENABLE_TAILSCALE="0"                # Tailscale-CLIENT installieren (Opt-in, KEIN Onboarding, keine Keys).
                                    # Manuell + nicht persistent: laeuft nur nach 'tailscale up', nach Reboot aus.
                                    # Braucht ein Tailscale-Konto ODER einen eigenen Headscale-Server.
                                    # Ohne Server: auf 0 lassen. Onboarding + Anleitung: docs/TAILSCALE.de.md
TAILSCALE_LOGIN_SERVER=""           # eigene Headscale-URL fuer 'piportal --tailscale-up' (tsup).
                                    # Leer = Tailscale-Cloud. Bleibt lokal/gitignoriert, NICHT im Repo.

# --- Update-Routine (tools/update) ---
UPDATE_INTERVAL_DAYS="14"          # Pause (Tage) zwischen Wartungslaeufen (Login-Abfrage)
UPDATE_REBOOT_MODE="ask"           # ask | auto | manual  – Reboot nach Updates
UPDATE_CHANNEL="release"           # release | main  – woher das PiPortal-Selbstupdate zieht.
                                    #   release = hoechstes veroeffentlichtes Tag (vX.Y.Z).
                                    #             Nur freigegebene Staende, empfohlen.
                                    #   main    = Spitze des Entwicklungszweigs.
                                    #             Fuer Geraete, auf denen entwickelt wird.

# -------------------------------------------------------------- Swap & zram --
# SD-Swapfile-Größe. "auto" = nach SD-Kartengröße staffeln:
#   >=64 GB => 16 GB | >=32 GB => 8 GB | >=16 GB => 4 GB | sonst => 2 GB
# Alternativ feste Größe in MiB (z. B. 8192) oder 0 zum Deaktivieren.
SWAP_MODE="auto"
SWAP_LOCATION="/var/swap"
SWAP_RESERVE_MIB="8192"             # so viel Plattenplatz mind. frei lassen
SWAPPINESS="80"                     # höher = eher auslagern (zram ist schnell)

# zram = komprimierter Swap IM RAM (NICHT auf SD, RAM-begrenzt).
ENABLE_ZRAM="1"
ZRAM_PERCENT="75"                   # Anteil des RAM, der als zram dient

# ------------------------------------------------------------------ Backup ---
BACKUP_DIR="/var/backups/piportal"  # Ziel der automatischen Sicherungen
