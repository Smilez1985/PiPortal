#!/usr/bin/env bash
# =============================================================================
#  piportal – Verwaltungs-CLI für den PiPortal
#  Befehle:
#     piportal --status        Kompakter Statusüberblick (IP, Uptime, CPU, RAM …)
#     piportal --wifi-switch    WLAN wechseln (Menü) oder: --wifi-switch next
#     piportal --update         System aktualisieren + Reboot
#     piportal --help           Diese Hilfe
#  Gedacht auch für die Steuerung vom Host-PC über die USB-Verbindung
#  (ssh dietpi@10.10.0.1), selbst wenn gerade kein WLAN verbunden ist.
# =============================================================================
set -uo pipefail

CONF="/etc/piportal/piportal.conf"
USB_LAN_IP="10.10.0.1"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF" 2>/dev/null

WIFI_IFACE="wlan0"

# ---- Farben (nur bei Terminal) ------------------------------------------------
if [ -t 1 ]; then
    B=$'\033[1m'; DIM=$'\033[2m'; R=$'\033[0m'
    CY=$'\033[36m'; GN=$'\033[32m'; YL=$'\033[33m'; RD=$'\033[31m'
else
    B=""; DIM=""; R=""; CY=""; GN=""; YL=""; RD=""
fi

# sudo-Wrapper (CLI wird meist als dietpi aufgerufen, braucht aber wpa_cli/reboot).
_sudo() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

# ==============================================================================
#  --status
# ==============================================================================
cmd_status() {
    local host up load temp mem_used mem_tot swap_used swap_tot zram
    host="$(hostname)"
    up="$(uptime -p 2>/dev/null | sed 's/^up //')"
    load="$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)"

    # CPU-Temperatur (vcgencmd oft nicht verfügbar -> thermal_zone).
    if [ -r /sys/class/thermal/thermal_zone0/temp ]; then
        temp="$(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))°C"
    else
        temp="n/a"
    fi

    # RAM/Swap in MiB.
    read -r mem_tot mem_used <<<"$(free -m | awk '/^Speicher:|^Mem:/{print $2, $3}')"
    read -r swap_tot swap_used <<<"$(free -m | awk '/^Swap:/{print $2, $3}')"
    zram="$(zramctl --noheadings 2>/dev/null | awk '{print $3}' | head -1)"

    # Netzwerk.
    local ip_usb ip_wlan ssid signal
    ip_usb="$(ip -4 -br addr show usb0 2>/dev/null | awk '{print $3}')"
    ip_wlan="$(ip -4 -br addr show "$WIFI_IFACE" 2>/dev/null | awk '{print $3}')"
    ssid="$(_sudo wpa_cli -i "$WIFI_IFACE" status 2>/dev/null | sed -n 's/^ssid=//p')"
    signal="$(_sudo wpa_cli -i "$WIFI_IFACE" signal_poll 2>/dev/null | sed -n 's/^RSSI=//p')"
    [ -n "$signal" ] && signal="${signal} dBm"

    # Verbundener Host (DHCP-Lease auf usb0).
    local host_lease
    host_lease="$(awk '{print $3" ("$4")"}' /var/lib/misc/dnsmasq.leases 2>/dev/null | head -1)"

    # Dienste.
    svc() { systemctl is-active "$1" 2>/dev/null | grep -q active && printf '%son%s' "$GN" "$R" || printf '%soff%s' "$RD" "$R"; }

    printf '\n%s╭─ PiPortal ─ %s ─────────────────────────────╮%s\n' "$CY" "$host" "$R"
    printf '  %sUptime%s   %s   %sLast%s %s\n' "$B" "$R" "${up:-n/a}" "$DIM" "$R" "${load:-n/a}"
    printf '  %sCPU-Temp%s %s\n' "$B" "$R" "$temp"
    printf '  %sRAM%s      %s / %s MiB    %sSwap%s %s / %s MiB   %szram%s %s\n' \
        "$B" "$R" "${mem_used:-?}" "${mem_tot:-?}" "$B" "$R" "${swap_used:-?}" "${swap_tot:-?}" "$DIM" "$R" "${zram:-n/a}"
    printf '%s├─ Netzwerk ─────────────────────────────────────┤%s\n' "$CY" "$R"
    printf '  %susb0%s  %s   %s(Steuerung/SMB)%s\n' "$B" "$R" "${ip_usb:-–}" "$DIM" "$R"
    printf '  %swlan0%s %s   %sSSID:%s %s   %sSignal:%s %s\n' "$B" "$R" "${ip_wlan:-–}" "$DIM" "$R" "${ssid:-–}" "$DIM" "$R" "${signal:-n/a}"
    printf '  %sHost am USB%s %s\n' "$B" "$R" "${host_lease:-– (keiner verbunden)}"
    printf '%s├─ Dienste ──────────────────────────────────────┤%s\n' "$CY" "$R"
    printf '  Gadget %s   dnsmasq %s   Samba %s   WLAN-Roam %s\n' \
        "$(svc piportal-gadget)" "$(svc dnsmasq)" "$(svc smbd)" "$(svc piportal-wifi-roam)"
    printf '%s╰────────────────────────────────────────────────╯%s\n\n' "$CY" "$R"
}

# ==============================================================================
#  --wifi-switch  [next | <id>]
# ==============================================================================
# Listet konfigurierte Netze: gibt "id<TAB>ssid<TAB>flags" aus.
_wifi_list() { _sudo wpa_cli -i "$WIFI_IFACE" list_networks 2>/dev/null | tail -n +2; }
_wifi_current_id() { _wifi_list | awk -F'\t' '/\[CURRENT\]/{print $1; exit}'; }

_wifi_apply() {
    local id="$1"
    _sudo wpa_cli -i "$WIFI_IFACE" select_network "$id" >/dev/null 2>&1
    # Nach dem gezielten Wechsel alle Netze wieder als Kandidaten zulassen,
    # damit Reconnect/Roaming bei Verlust weiter funktioniert.
    _sudo wpa_cli -i "$WIFI_IFACE" enable_network all >/dev/null 2>&1
    _sudo wpa_cli -i "$WIFI_IFACE" save_config >/dev/null 2>&1
    echo "${GN}Wechsle zu Netzwerk-ID ${id}…${R} (Aufbau kann einige Sekunden dauern)"
}

cmd_wifi_switch() {
    local arg="${1:-}"
    local list; list="$(_wifi_list)"
    if [ -z "$list" ]; then
        echo "${RD}Keine WLAN-Netzwerke konfiguriert.${R}"; return 1
    fi
    local count; count="$(printf '%s\n' "$list" | wc -l)"
    local cur; cur="$(_wifi_current_id)"

    # Variante A: gezielte ID.
    if printf '%s' "$arg" | grep -qE '^[0-9]+$'; then
        _wifi_apply "$arg"; return 0
    fi

    # Variante B: "next" -> zur nächsten ID rotieren.
    if [ "$arg" = "next" ]; then
        local ids next
        ids="$(printf '%s\n' "$list" | cut -f1)"
        if [ -n "$cur" ]; then
            next="$(printf '%s\n' "$ids" | awk -v c="$cur" 'BEGIN{f=0} {a[NR]=$0} END{for(i=1;i<=NR;i++) if(a[i]==c){print a[(i%NR)+1]; f=1}; if(!f) print a[1]}')"
        else
            next="$(printf '%s\n' "$ids" | head -1)"
        fi
        _wifi_apply "$next"; return 0
    fi

    # Variante C (Default): Menü.
    echo
    echo "${B}Verfügbare WLAN-Profile:${R}"
    printf '%s\n' "$list" | while IFS=$'\t' read -r id ssid bssid flags; do
        local mark="  "
        printf '%s' "$flags" | grep -q '\[CURRENT\]' && mark="${GN}➜ ${R}"
        printf '   %s[%s] %s %s\n' "$mark" "$id" "${ssid:-<versteckt>}" "${DIM}${flags}${R}"
    done
    echo
    local sel
    read -r -p "Netzwerk-ID wählen (leer = abbrechen): " sel
    [ -z "$sel" ] && { echo "Abgebrochen."; return 0; }
    if printf '%s' "$sel" | grep -qE '^[0-9]+$'; then
        _wifi_apply "$sel"
    else
        echo "${RD}Ungültige Auswahl.${R}"; return 1
    fi
}

# ==============================================================================
#  --update
# ==============================================================================
cmd_update() {
    local yes="${1:-}"
    echo "${YL}${B}PiPortal-Update${R}"
    echo "  Führt aus: dietpi-update  ->  apt update && upgrade  ->  Reboot"
    if [ "$yes" != "-y" ] && [ "$yes" != "--yes" ]; then
        local a; read -r -p "Fortfahren und danach neu starten? [j/N] " a
        case "$a" in [jJyY]|[jJ][aA]) ;; *) echo "Abgebrochen."; return 0;; esac
    fi
    echo "${CY}» DietPi-Update…${R}"
    if [ -x /boot/dietpi/dietpi-update ]; then _sudo /boot/dietpi/dietpi-update 1; else echo "  (dietpi-update nicht gefunden, übersprungen)"; fi
    echo "${CY}» apt update/upgrade…${R}"
    _sudo apt-get update
    DEBIAN_FRONTEND=noninteractive _sudo apt-get -y -o Dpkg::Options::=--force-confold upgrade
    _sudo apt-get -y autoremove --purge
    sync
    echo "${GN}Fertig – starte neu…${R}"
    _sudo systemd-run --no-block reboot 2>/dev/null || _sudo reboot
}

# ==============================================================================
#  --smb-passwd   (Netzlaufwerk-Passwort SETZEN/aendern – keine Daten geloescht)
#  Fuer die Erst-Einrichtung und spaetere Passwortwechsel.
# ==============================================================================
cmd_smb_passwd() {
    local user="${SMB_USER:-dietpi}"
    local share_name="${SMB_SHARE_NAME:-PiPortal}"
    local share_path="${SMB_SHARE_PATH:-/srv/piportal/share}"
    local smbconf="/etc/samba/smb.conf"

    echo
    echo "${CY}${B}PiPortal – Netzlaufwerk-Passwort setzen/ändern${R}"
    echo "  Benutzer: ${B}${user}${R}   (Enter = beibehalten). ${DIM}Dateien bleiben unangetastet.${R}"
    local newuser
    read -r -p "SMB-Benutzername [${user}]: " newuser
    newuser="${newuser:-$user}"

    local pw1 pw2
    read -r -s -p "Neues Passwort: " pw1; echo
    read -r -s -p "Passwort wiederholen: " pw2; echo
    if [ -z "$pw1" ] || [ "$pw1" != "$pw2" ]; then
        echo "${RD}Passwoerter leer oder ungleich - Abbruch.${R}"; return 1
    fi

    if ! id -u "$newuser" >/dev/null 2>&1; then
        echo "${CY}» Lege Systembenutzer '${newuser}' an…${R}"
        _sudo useradd -m -s /bin/bash "$newuser" || { echo "${RD}Benutzer anlegen fehlgeschlagen.${R}"; return 1; }
    fi
    if [ "$newuser" != "$user" ] && [ -f "$smbconf" ]; then
        _sudo sed -i -E \
            "s/^([[:space:]]*valid users[[:space:]]*=).*/\1 ${newuser}/; \
             s/^([[:space:]]*force user[[:space:]]*=).*/\1 ${newuser}/; \
             s/^([[:space:]]*force group[[:space:]]*=).*/\1 ${newuser}/" "$smbconf"
        _sudo chown "${newuser}:${newuser}" "$share_path" 2>/dev/null || true
    fi
    if printf '%s\n%s\n' "$pw1" "$pw1" | _sudo smbpasswd -a -s "$newuser" >/dev/null; then
        _sudo systemctl restart smbd 2>/dev/null || _sudo systemctl restart smb 2>/dev/null || true
        echo "${GN}${B}Passwort gesetzt.${R} Zugang:  \\\\${USB_LAN_IP}\\${share_name}   (Benutzer: ${B}${newuser}${R})"
    else
        echo "${RD}smbpasswd fehlgeschlagen.${R}"; return 1
    fi
}

# ==============================================================================
#  --smb-reset   (Netzlaufwerk-Zugang zuruecksetzen; Berechtigung = SSH-Login)
# ==============================================================================
cmd_smb_reset() {
    local user="${SMB_USER:-dietpi}"
    local share_name="${SMB_SHARE_NAME:-PiPortal}"
    local share_path="${SMB_SHARE_PATH:-/srv/piportal/share}"
    local smbconf="/etc/samba/smb.conf"

    echo
    echo "${RD}${B}==================== PiPortal SMB-Reset ====================${R}"
    echo "${YL}ACHTUNG:${R} Setzt den Zugang zum PiPortal-Netzlaufwerk zurueck."
    echo "  - ${RD}${B}ALLE Dateien im Share werden GELOESCHT${R}: ${share_path}"
    echo "  - Benutzer und Passwort werden neu vergeben (Repo-Standard)."
    echo "  - Aktueller SMB-Benutzer: ${B}${user}${R}"
    echo
    local confirm
    read -r -p "Zum Fortfahren exakt  RESET  eingeben (sonst Abbruch): " confirm
    [ "$confirm" = "RESET" ] || { echo "Abgebrochen."; return 0; }

    local newuser
    read -r -p "Neuer SMB-Benutzername [${user}]: " newuser
    newuser="${newuser:-$user}"

    local pw1 pw2
    read -r -s -p "Neues Passwort: " pw1; echo
    read -r -s -p "Passwort wiederholen: " pw2; echo
    if [ -z "$pw1" ] || [ "$pw1" != "$pw2" ]; then
        echo "${RD}Passwoerter leer oder ungleich - Abbruch.${R}"; return 1
    fi

    # 1) Systembenutzer sicherstellen.
    if ! id -u "$newuser" >/dev/null 2>&1; then
        echo "${CY}» Lege Systembenutzer '${newuser}' an…${R}"
        _sudo useradd -m -s /bin/bash "$newuser" || { echo "${RD}Benutzer anlegen fehlgeschlagen.${R}"; return 1; }
    fi

    # 2) smb.conf auf neuen Benutzer umstellen (nur die relevanten Zeilen).
    if [ "$newuser" != "$user" ] && [ -f "$smbconf" ]; then
        _sudo sed -i -E \
            "s/^([[:space:]]*valid users[[:space:]]*=).*/\1 ${newuser}/; \
             s/^([[:space:]]*force user[[:space:]]*=).*/\1 ${newuser}/; \
             s/^([[:space:]]*force group[[:space:]]*=).*/\1 ${newuser}/" "$smbconf"
    fi

    # 3) Share leeren + Rechte auf Repo-Standard.
    echo "${CY}» Leere Share ${share_path}…${R}"
    _sudo mkdir -p "$share_path"
    _sudo find "$share_path" -mindepth 1 -delete 2>/dev/null || true
    _sudo chown "${newuser}:${newuser}" "$share_path"
    _sudo chmod 2775 "$share_path"

    # 4) connect-Helfer (Repo-Standard) wiederherstellen, falls Quelle auffindbar.
    local helper
    for helper in /home/*/PiPortal/assets/windows/connect-piportal.cmd /opt/PiPortal/assets/windows/connect-piportal.cmd; do
        [ -f "$helper" ] || continue
        _sudo cp "$helper" "${share_path}/connect-piportal.cmd"
        _sudo chown "${newuser}:${newuser}" "${share_path}/connect-piportal.cmd"
        break
    done

    # 5) Altes SMB-Konto bei Benutzerwechsel entfernen, neues Passwort setzen.
    [ "$newuser" != "$user" ] && _sudo smbpasswd -x "$user" 2>/dev/null || true
    if printf '%s\n%s\n' "$pw1" "$pw1" | _sudo smbpasswd -a -s "$newuser" >/dev/null; then
        echo "${GN}SMB-Benutzer '${newuser}' neu gesetzt.${R}"
    else
        echo "${RD}smbpasswd fehlgeschlagen.${R}"; return 1
    fi

    # 6) Konfiguration pruefen + Dienst neu starten.
    if _sudo testparm -s >/dev/null 2>&1; then
        _sudo systemctl restart smbd 2>/dev/null || _sudo systemctl restart smb 2>/dev/null || true
        echo "${GN}${B}Fertig.${R} Zugang:  \\\\${USB_LAN_IP}\\${share_name}   (Benutzer: ${B}${newuser}${R})"
    else
        echo "${RD}smb.conf fehlerhaft nach Aenderung - bitte pruefen.${R}"; return 1
    fi
}

# ==============================================================================
#  start claude   (Claude Code CLI starten; installiert sie, falls nicht da)
# ==============================================================================
cmd_start_claude() {
    if ! command -v claude >/dev/null 2>&1; then
        echo "${YL}Claude Code CLI nicht installiert – installiere jetzt (neueste Version)…${R}"
        if ! command -v node >/dev/null 2>&1; then
            echo "${CY}» Node.js LTS…${R}"
            _sudo apt-get install -y ca-certificates curl \
                || { echo "${RD}Abbruch: curl/ca-certificates nicht installierbar.${R}"; return 1; }
            curl -fsSL https://deb.nodesource.com/setup_lts.x | _sudo -E bash - >/dev/null 2>&1 \
                || { echo "${RD}NodeSource-Setup fehlgeschlagen.${R}"; return 1; }
            _sudo apt-get install -y nodejs \
                || { echo "${RD}Node.js-Installation fehlgeschlagen.${R}"; return 1; }
        fi
        echo "${CY}» npm i -g @anthropic-ai/claude-code@latest…${R}"
        _sudo npm install -g @anthropic-ai/claude-code@latest \
            || { echo "${RD}Claude-Code-Installation fehlgeschlagen.${R}"; return 1; }
        echo "${GN}Claude Code CLI installiert.${R}"
    fi
    echo "${CY}» starte claude…${R}"
    exec claude
}

# ==============================================================================
#  Hilfe / Dispatch
# ==============================================================================
cmd_help() {
    cat <<EOF
${B}piportal${R} – Verwaltungs-CLI für den PiPortal

  ${CY}piportal --status${R}         Kompakter Überblick: IP, Uptime, CPU-Temp, RAM/Swap, Dienste
  ${CY}piportal --wifi-switch${R}    WLAN-Profil wechseln (Menü)
  ${CY}piportal --wifi-switch next${R}  Zum nächsten konfigurierten WLAN rotieren
  ${CY}piportal --wifi-switch <id>${R}  Gezielt zu WLAN-ID wechseln
  ${CY}piportal --update${R}         dietpi-update + apt upgrade + Reboot (mit -y ohne Rückfrage)
  ${CY}piportal --smb-passwd${R}     Netzlaufwerk-Passwort setzen/ändern (Erst-Einrichtung, keine Daten weg)
  ${CY}piportal --smb-reset${R}      Netzlaufwerk-Zugang zurücksetzen (löscht Share-Inhalt!)
  ${CY}piportal start claude${R}     Claude Code CLI starten (installiert sie automatisch, falls nötig)
  ${CY}piportal --help${R}           Diese Hilfe

Tipp: Vom Host-PC per USB erreichbar mit  ${DIM}ssh dietpi@${USB_LAN_IP}${R}  –
auch wenn der Pi gerade kein WLAN hat.
EOF
}

case "${1:-}" in
    --status|status|-s)        cmd_status ;;
    --wifi-switch|wifi-switch|-w) shift 2>/dev/null; cmd_wifi_switch "${1:-}" ;;
    --update|update|-u)        shift 2>/dev/null; cmd_update "${1:-}" ;;
    --smb-passwd|smb-passwd)   cmd_smb_passwd ;;
    --smb-reset|smb-reset)     cmd_smb_reset ;;
    start|--start)             shift 2>/dev/null
                               case "${1:-}" in
                                   claude) cmd_start_claude ;;
                                   *) echo "${RD}Unbekannt: start ${1:-}${R}"; echo "  Verfügbar: ${CY}piportal start claude${R}"; exit 1 ;;
                               esac ;;
    --help|help|-h|"")         cmd_help ;;
    *) echo "${RD}Unbekannter Befehl: $1${R}"; echo; cmd_help; exit 1 ;;
esac
